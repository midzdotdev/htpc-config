# Output layout, owned by kanshi.
#
# This used to be a one-shot `wlr-randr` at session start, which silently lost
# the scale: turning the TV off (or switching its input) disconnects HDMI, and
# wlroots then destroys and recreates the output with default settings, so the
# UI dropped back to 100% while Cage kept running and never re-ran the script.
# The laptop panel never showed the problem because an internal output does not
# hotplug. kanshi watches for output changes and re-applies the matching
# profile, so a TV power cycle no longer resets anything.
#
# Profiles match on the exact set of connected outputs, so the TV profile has
# to name eDP-1 too.

profile tv {
	# scale 1.25 renders the UI at 125% — a 1536x864 logical desktop on the
	# 1080p panel. Stremio has no interface-size setting of its own, and at
	# 100% the text is too small from the sofa.
	output HDMI-A-1 enable mode 1920x1080@60Hz position 0,0 scale 1.25
	# A TV coming back is activity, even though it generates no input event.
	# Only fires if the link actually dropped — which this TV has stopped
	# doing — so it is a belt-and-braces path, not the primary one. With a TV
	# that holds HDMI up, the first remote press clears the inhibit instead.
	exec ~/bin/idle-stop.sh --clear
	# Cage spans every connected output by default, which would stretch the
	# UI across the TV and the laptop panel.
	output eDP-1 disable
}

# No TV attached: keep the built-in panel usable so the box works on its own,
# and stop Stremio. The hook debounces first, so switching the TV's input does
# not cost you your place — see tv-off-hook.sh for why it is stopped at all.
profile panel {
	output eDP-1 enable position 0,0
	exec ~/bin/tv-off-hook.sh
}
